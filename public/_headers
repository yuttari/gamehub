# Cloudflare Pages edge security headers (applied at the CDN, no server needed)
# These replace the server-side headers from next.config.js, which are skipped
# during static export. They keep the site hardened on static hosting.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://pagead2.googlesyndication.com https://*.googlesyndication.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-src 'self' https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests
